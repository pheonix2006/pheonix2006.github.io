---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import siteConfig from '../data/site-config';

export interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  pageType?: 'website' | 'article';
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/project-placeholder.svg',
  pageType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? siteConfig.website);
const imageURL = typeof image === 'string' ? new URL(image, Astro.url).toString() : new URL(image.src, Astro.url).toString();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={new URL('/rss.xml', Astro.site ?? siteConfig.website)} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={pageType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
