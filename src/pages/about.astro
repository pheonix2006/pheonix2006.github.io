---
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`About - ${siteConfig.title}`} description="李行健的教育背景、实习经历和技术方向。">
  <article class="prose-content">
    <header class="article-header">
      <div class="eyebrow">
        <span>About</span>
        <span>{siteConfig.profile.handle}</span>
      </div>
      <h1 class="page-title">{siteConfig.profile.name} / {siteConfig.profile.englishName}</h1>
      <p class="page-description">
        香港科技大学（广州）人工智能本科，主要关注 AI Agent、多智能体系统、RAG、低代码生成平台与工程自动化。
      </p>
    </header>

    <h2>Education</h2>
    {
      siteConfig.education.map((item) => (
        <section>
          <h3>{item.school}</h3>
          <p>
            {item.degree}, {item.period}, {item.location}.
          </p>
          <ul>
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>Experience</h2>
    {
      siteConfig.experience.map((item) => (
        <section>
          <h3>
            {item.company} - {item.role}
          </h3>
          <p>
            {item.period}, {item.location}.
          </p>
          <ul>
            {item.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>Technical Focus</h2>
    {
      siteConfig.skillGroups.map((group) => (
        <section>
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>Languages</h2>
    <ul>
      {siteConfig.languages.map((language) => <li>{language}</li>)}
    </ul>

    <h2>Portfolio</h2>
    <p>
      这个网站不是简单的 GitHub 仓库索引，而是面向求职和项目审阅的作品集。项目页会保留较完整的背景、架构、技术取舍、实验结果和局限分析。
    </p>
  </article>
</BaseLayout>
