---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisiblePost, sortByPubDateDesc } from '../../lib/content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isVisiblePost).sort(sortByPubDateDesc);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, tags, repo, paper } = post.data;
---

<BaseLayout title={`${title} - ${siteConfig.title}`} description={description} image={heroImage} pageType="article" class="narrow">
  <article>
    <a class="button" href="/blog">Back to Blog</a>

    <header class="article-header">
      <div class="article-meta">
        <span>Article</span>
        <FormattedDate date={pubDate} />
        {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-description">{description}</p>
      {
        tags && tags.length > 0 && (
          <ul class="tag-list" aria-label="Article tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        (paper || repo) && (
          <div class="article-links">
            {paper && (
              <a class="button primary" href={paper} target="_blank" rel="noopener noreferrer">
                Read Paper
              </a>
            )}
            {repo && (
              <a class="button" href={repo} target="_blank" rel="noopener noreferrer">
                GitHub Repo
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      heroImage && typeof heroImage === 'object' && 'src' in heroImage && (
        <figure class="article-hero">
          <Image src={heroImage} alt={title} width={heroImage.width} height={heroImage.height} />
        </figure>
      )
    }

    <div class="prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>
