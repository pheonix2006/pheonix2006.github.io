---
import { getCollection } from 'astro:content';
import PostPreview from '../../components/PostPreview.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisiblePost, sortByPubDateDesc } from '../../lib/content';

const posts = (await getCollection('blog')).filter(isVisiblePost).sort(sortByPubDateDesc);
---

<BaseLayout title={`Blog - ${siteConfig.title}`} description="技术文章、论文解析与工程思考。">
  <header class="article-header">
    <div class="eyebrow">
      <span>Writing</span>
      <span>{posts.length} posts</span>
    </div>
    <h1 class="page-title">Blog</h1>
    <p class="page-description">这里保留和项目方向相关的长文写作，用于补充技术背景和研究理解。</p>
  </header>

  <div class="preview-list">
    {posts.map((post) => <PostPreview post={post} />)}
  </div>
</BaseLayout>
