---
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Contact - ${siteConfig.title}`} description="李行健的公开联系信息。">
  <article>
    <header class="article-header">
      <div class="eyebrow">
        <span>Contact</span>
        <span>{siteConfig.profile.handle}</span>
      </div>
      <h1 class="page-title">Contact</h1>
      <p class="page-description">可以通过学校邮箱、GitHub 或电话联系我。项目源码和长期更新会优先放在 GitHub 与本站项目页。</p>
    </header>

    <div class="contact-grid">
      <article class="contact-card">
        <span>Email</span>
        <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
      </article>
      <article class="contact-card">
        <span>Phone</span>
        <p>{siteConfig.contact.phone}</p>
      </article>
      <article class="contact-card">
        <span>GitHub</span>
        <a href={siteConfig.contact.github} target="_blank" rel="noopener noreferrer">
          github.com/pheonix2006
        </a>
      </article>
      <article class="contact-card">
        <span>Location</span>
        <p>{siteConfig.contact.location}</p>
      </article>
    </div>
  </article>
</BaseLayout>
