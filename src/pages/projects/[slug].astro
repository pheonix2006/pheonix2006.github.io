---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisibleProject, sortByPubDateDesc } from '../../lib/content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(isVisibleProject).sort(sortByPubDateDesc);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, pubDate, updatedDate, heroImage, tags, repo, url, urlLabel } = project.data;
---

<BaseLayout title={`${title} - ${siteConfig.title}`} description={description} image={heroImage} pageType="article" class="narrow">
  <article>
    <a class="button" href="/projects">Back to Projects</a>

    <header class="article-header">
      <div class="article-meta">
        <span>Project</span>
        <FormattedDate date={pubDate} />
        {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
      </div>
      <h1 class="article-title">{title}</h1>
      <p class="article-description">{description}</p>
      {
        tags && tags.length > 0 && (
          <ul class="tag-list" aria-label="Project tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        (repo || url) && (
          <div class="article-links">
            {repo && (
              <a class="button primary" href={repo} target="_blank" rel="noopener noreferrer">
                GitHub 仓库
              </a>
            )}
            {url && (
              <a class="button" href={url} target="_blank" rel="noopener noreferrer">
                {urlLabel ?? '项目演示'}
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      heroImage && typeof heroImage === 'object' && 'src' in heroImage && (
        <figure class="article-hero project-detail-hero">
          <Image src={heroImage} alt={title} width={heroImage.width} height={heroImage.height} />
        </figure>
      )
    }

    <div class="prose-content">
      <Content />
    </div>
  </article>

  <script>
    async function initMermaid() {
      const blocks = document.querySelectorAll('pre[data-language="mermaid"] code, pre code.language-mermaid');
      if (blocks.length === 0) return;

      const mermaidApi = (window as any).mermaid;
      if (typeof mermaidApi === 'undefined') {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
        script.onload = () => renderMermaid(blocks);
        document.head.appendChild(script);
      } else {
        renderMermaid(blocks);
      }
    }

    async function renderMermaid(blocks) {
      const mermaidApi = (window as any).mermaid;
      mermaidApi.initialize({
        startOnLoad: false,
        theme: 'neutral',
        flowchart: { useMaxWidth: true, htmlLabels: true, curve: 'basis' },
        securityLevel: 'loose',
      });

      blocks.forEach(async (block, index) => {
        const pre = block.parentElement;
        if (!pre) return;
        try {
          const graphDefinition = block.textContent || '';
          const { svg } = await mermaidApi.render(`mermaid-${index}-${Date.now()}`, graphDefinition);
          const container = document.createElement('div');
          container.className = 'mermaid-diagram';
          container.innerHTML = svg;
          pre.replaceWith(container);
        } catch (error) {
          console.error('Mermaid render error:', error);
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initMermaid);
    document.addEventListener('astro:page-load', initMermaid);
  </script>
</BaseLayout>
