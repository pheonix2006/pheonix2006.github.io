---
import { getCollection } from 'astro:content';
import ProjectPreview from '../../components/ProjectPreview.astro';
import siteConfig from '../../data/site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isVisibleProject, sortByPubDateDesc } from '../../lib/content';

const projects = (await getCollection('projects')).filter(isVisibleProject).sort(sortByPubDateDesc);
---

<BaseLayout title={`Projects - ${siteConfig.title}`} description="完整项目长文、源码链接与技术实践记录。">
  <header class="article-header">
    <div class="eyebrow">
      <span>Portfolio</span>
      <span>{projects.length} projects</span>
    </div>
    <h1 class="page-title">Projects</h1>
    <p class="page-description">每个项目都保留完整背景、架构、技术取舍、结果和源码链接，而不是只展示一张卡片。</p>
  </header>

  <div class="preview-list">
    {projects.map((project) => <ProjectPreview project={project} />)}
  </div>
</BaseLayout>
